# ============================================================================
# NEUROGRIP / NEUROPULSE ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# NOTE: All entries below are commented out by default so the AI Studio Secrets
# prompt does NOT block or require manual input when running the Android app
# directly against the provisioned Firebase Cloud Firestore database.
#
# PostgreSQL (`DATABASE_URL`) has been completely removed and is NOT used.
#
# 1. PROVISIONED FIREBASE & INFRASTRUCTURE IDENTIFIERS
#    (Already configured in `app/google-services.json` and
#     `app/src/main/res/values/firebase_applet_config.xml`)
# FIREBASE_PROJECT_ID=gen-lang-client-0929832946
# FIRESTORE_DATABASE_ID=ai-studio-android-neuropul-c40fab35-e98a-46c6-850b-96b0e10b6910
# FCM_PROJECT_ID=gen-lang-client-0929832946
# ADMIN_BACKEND_BASE_URL=http://10.0.2.2:8000
#
# 2. SAFE DYNAMIC RUNTIME SETTINGS & DEVELOPMENT TESTING
#    (Stored in Firestore `system_config/runtime_settings` and editable live
#     by SUPER_ADMIN in the Android "System Configuration" screen)
# SESSION_TTL_MINUTES=30
# RATE_LIMIT_PER_MINUTE=60
# OTP_TTL_SECONDS=60
# OTP_MAX_SENDS=3
# OTP_WINDOW_SECONDS=600
#
# SERVER-SIDE DEVELOPMENT TESTING OTP (Accepted only for authorized test accounts in dev/test):
# OTP_TEST_MODE=true
# (Production environment must set ENV=production which automatically disables 000000)
# AUTHORIZED_TEST_ACCOUNTS=hj195345@gmail.com,hj195344@gmail.com,hj123,joshi@neurogrip.io,joshi,patient.otp@example.com
#
# 3. INITIAL BOOTSTRAP SETTINGS
#    (Used only for initial seed of Super Admin account; rotate credentials
#     via the in-app Super Admin Password Rotation dialog)
# ADMIN_INITIAL_USERNAME=hj123
# ADMIN_INITIAL_PASSWORD_HASH=<PBKDF2_OR_SHA256_BOOTSTRAP_HASH>
#
# 4. SERVER-ONLY SECRETS (STRICTLY FOR BACKEND SERVER `backend/main.py` ONLY)
#    (NEVER embed in Android client source code, Firestore, or git commits)
# ADMIN_HMAC_SECRET=<GENERATE_WITH_openssl_rand_hex_32>
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# RESEND_API_KEY=<SERVER_SIDE_RESEND_API_KEY>
# RESEND_FROM_EMAIL=onboarding@resend.dev
# SENDGRID_API_KEY=<SERVER_SIDE_SENDGRID_API_KEY>
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hj195345@gmail.com
# SMTP_PASSWORD=<SERVER_SIDE_SMTP_APP_PASSWORD>
# SMTP_FROM=hj195345@gmail.com
